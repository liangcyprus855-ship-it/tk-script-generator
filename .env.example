# 可选：如果你希望 Gemini Key 放在本机环境文件，而不是每次在网页输入
GEMINI_API_KEY=

# 可选：本地服务端口，默认 3000
PORT=3000

# 商业后台部署时使用：商业模式会忽略客户端提交的模型与 API Key，只读取服务器环境变量
TK_COMMERCIAL_MODE=false
TK_COMMERCIAL_PROVIDER=ollama
TK_COMMERCIAL_BASE_URL=http://127.0.0.1:11434
TK_COMMERCIAL_MODEL=
TK_COMMERCIAL_API_KEY=
TK_COMMERCIAL_CLOUD_PROVIDER=openai
TK_COMMERCIAL_INPUT_MODE=text

# 支付上线配置（不要把真实密钥提交到 Git）
PAYMENT_WEBHOOK_SECRET=
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_NOTIFY_URL=https://your-domain.example.com/api/billing/webhook/wechat
WECHAT_PLATFORM_CERT_PATH=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_API_BASE_URL=https://api.mch.weixin.qq.com
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
