# 可选：如果你希望 Gemini Key 放在本机环境文件，而不是每次在网页输入
GEMINI_API_KEY=

# 可选：本地服务端口，默认 3000
PORT=3000

# 商业后台部署时使用：商业模式会忽略客户端提交的模型与 API Key，只读取服务器环境变量
TK_COMMERCIAL_MODE=false
TK_COMMERCIAL_PROVIDER=ollama
TK_COMMERCIAL_BASE_URL=http://127.0.0.1:11434
TK_COMMERCIAL_MODEL=
TK_COMMERCIAL_API_KEY=
TK_COMMERCIAL_CLOUD_PROVIDER=openai
TK_COMMERCIAL_INPUT_MODE=text
