{
  "name": "tk-script-generator",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "dev": "tsx server-cli.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/build-sites-worker.mjs",
    "build:commercial": "vite build --mode commercial && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/build-sites-worker.mjs",
    "start": "node scripts/start.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "desktop:dev": "npm run build && electron . --development",
    "desktop:pack": "electron-builder --win nsis --publish never",
    "desktop:pack:commercial": "npm run build:commercial && electron-builder --win nsis --publish never",
    "desktop:publish": "electron-builder --win nsis --publish always",
    "desktop:dir": "electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "lucide-react": "^1.37.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4"
  },
  "productName": "TK跨境带货脚本生成器",
  "description": "TK跨境带货脚本生成器：本地 Ollama 与云端 API 双模型工作流",
  "main": "electron/main.cjs"
}
